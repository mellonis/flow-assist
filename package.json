{
  "name": "flow-assist",
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "bin": {
    "flow-assist": "src/cli.ts"
  },
  "scripts": {
    "build": "tsc",
    "build:binary": "bun build --compile --define 'process.env.NODE_ENV=\"production\"' src/cli.ts --outfile dist/flow-assist",
    "plugin:publish": "bun run scripts/publish.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:binary": "FLOW_ASSIST_BINARY_TEST=1 bun test src/__tests__/binary.test.ts"
  },
  "dependencies": {
    "@flow-assist/remote": "workspace:*",
    "@flowtty/core": "^1.0.0-alpha.31",
    "@flowtty/react": "^1.0.0-alpha.31",
    "@flowtty/tty-backend": "^1.0.0-alpha.31",
    "react": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "~1.3.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}

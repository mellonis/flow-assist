{
  "name": "flow-assist",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "flow-assist": "src/cli.ts"
  },
  "scripts": {
    "build": "tsc",
    "build:binary": "bun build --compile src/cli.ts --outfile dist/flow-assist",
    "plugin:publish": "bun run scripts/publish.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@flowtty/react": "^1.0.0-alpha.16",
    "@flowtty/tty-backend": "^1.0.0-alpha.16",
    "react": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}

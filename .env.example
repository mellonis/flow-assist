# Example environment for the developer-assistant host.
# Copy to `.env` and fill in your values; secrets belong in env, not in config.
# The host itself reads only what is listed here. A plugin documents its own
# variables in its own README and declares them in its manifest's
# `requiredSettings`.

# Token for the LLM endpoint in `ai.baseUrl`. `ai.tokenEnv` can name another variable.
LLM_TOKEN=

# Optional plugin registry (a GitLab Generic Packages registry). There is no
# built-in default: unset, `plugins install` works from local sources only.
# DA_PLUGIN_REGISTRY_URL=https://gitlab.example.com/api/v4
# DA_PLUGIN_REGISTRY_PROJECT=group/project
# DA_PLUGIN_REGISTRY_TOKEN=
